---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { brand } from '../config/brand';
import { siteData } from '../data/siteData';
import { aboutImage as localAboutImage } from '../config/images';

const PLACEHOLDER = 'https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?w=900&q=80';

interface Props {
  topper?: string;
  heading?: string;
  body?: readonly string[] | string[];
  benefits?: string[];
  ctaLabel?: string;
  ctaHref?: string;
  imageSrc?: ImageMetadata | string;
  imageAlt?: string;
}

const {
  topper = 'Who We Are',
  heading = 'Dedicated to Preserving Words & Knowledge',
  body = siteData.about.story,
  benefits = [
    'ISO-compliant non-destructive book scanning',
    'Rigorous line-by-line editorial proofreading',
    'Standardized metadata extraction (MARC21, Dublin Core, ONIX)',
  ],
  ctaLabel = 'More About Us',
  ctaHref = '/about',
  imageSrc = localAboutImage ?? PLACEHOLDER,
  imageAlt = 'Glamkalai archival digitization and book preservation workspace',
} = Astro.props;
---

<section class="py-section">
  <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">

    <!-- Image -->
    <div class="overflow-hidden rounded-lg shadow-lg">
      <Image
        src={imageSrc}
        alt={imageAlt}
        width={700}
        height={525}
        loading="lazy"
        decoding="async"
        class="size-full object-cover"
      />
    </div>

    <!-- Content -->
    <div class="space-y-5">
      <span class="text-topper font-bold uppercase tracking-widest text-accent">{topper}</span>
      <h2 class="font-heading text-h2 font-bold uppercase text-text">{heading}</h2>

      {body.map((paragraph) => (
        <p class="text-text-muted leading-relaxed">{paragraph}</p>
      ))}

      <!-- Benefits list -->
      <ul class="space-y-3 pt-2" role="list">
        {benefits.map((benefit) => (
          <li class="flex items-start gap-3">
            <span class="mt-0.5 shrink-0 text-accent font-bold" aria-hidden="true">&check;</span>
            <span class="text-text">{benefit}</span>
          </li>
        ))}
      </ul>

      <div class="pt-2">
        <a
          href={ctaHref}
          class="inline-flex min-h-11 items-center gap-2 rounded-md bg-primary px-6 py-3 text-base font-bold text-primary-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {ctaLabel}
        </a>
      </div>
    </div>
  </div>
</section>
